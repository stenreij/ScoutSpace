<div class="container mt-2">
    <h1 class="display-4 text-center">Welkom ....</h1>

    <div class="row mt-3">
        <div class="col-6 col-md-3 mb-4">
            <a asp-area="" asp-controller="Player" asp-action="PlayerList">
                <div class="card card-hover">
                    <img src="~/images/player.png" class="card-img-top img-fluid mx-auto d-block mt-3" alt="Search Player Image">
                    <div class="card-body">
                        <h5 class="card-title text-center">Zoek Speler</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-3 mb-4">
            <a asp-area="" asp-controller="Team" asp-action="TeamList">
                <div class="card card-hover">
                    <img src="~/images/team.png" class="card-img-top img-fluid mx-auto d-block mt-3" alt="Search Team Image">
                    <div class="card-body">
                        <h5 class="card-title text-center">Zoek Team</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-3 mb-4">
            <a asp-area="" asp-controller="Scout" asp-action="ScoutList">
                <div class="card card-hover card-fluid">
                    <img src="~/images/scouts.png" class="card-img-top img-fluid mx-auto d-block mt-3" alt="Search Scout Image">
                    <div class="card-body">
                        <h5 class="card-title text-center">Zoek Scout</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-3 mb-4">
            <a asp-area="" asp-controller="Scout" asp-action="Profile">
                <div class="card card-hover">
                    <img src="~/images/profile.png" class="card-img-top img-fluid mx-auto d-block mt-3" alt="Profile Image">
                    <div class="card-body">
                        <h5 class="card-title text-center">Profiel</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
