@using Core.Domain.Extensions

@model IEnumerable<Core.Domain.Team>

@{
    ViewData["Title"] = "TeamList Page";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="description" content="TeamList Page">

    @section scripts {
        <script defer src="https://code.jquery.com/jquery-3.6.0.js"></script>
        <script defer src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.js"></script>
        <script defer src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.css">

        <script>
            $(document).ready(function () {
                $('#teamTable').DataTable({
                    "language": {
                        "url": "/datatables/Dutch.json"
                    },
                    "responsive": true,

                });
            });
        </script>
    }
</head>
<body>
    <div class="container-body">
        <a asp-area="" asp-controller="Team" asp-action="TeamAdd" class="btn btn-primary addButton mt-3" style="margin-right: 5px;">Voeg team toe</a>
        <a asp-area="" asp-controller="Team" asp-action="TeamPromotionRelegation" class="btn btn-primary addButton mt-3" style="margin-left: 5px;">Promotie / Degradatie</a>

        <div class="container mt-3">
            <div class="table-responsive custom-table-container">
                <table id="teamTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Clubnaam</th>
                            <th scope="col">Divisie/Klasse</th>
                            <th scope="col">Plaats</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Edit</th>
                            <th scope="col">Verwijder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in Model)
                        {
                            <tr style="vertical-align: middle;">
                                <th scope="row">@team.teamId</th>
                                <td><a asp-area="" asp-controller="Team" asp-action="TeamDetail" asp-route-id="@team.teamId" class="a-nav-link"><strong>@team.teamName</strong></a></td>
                                <td>@team.division.GetDisplayName()</td>
                                <td>@team.city</td>
                                <td>@team.contactNr</td>
                                <td>
                                    <a asp-controller="Team" asp-action="TeamUpdate" asp-route-id="@team.teamId" class="btn btn-primary editButton">Edit</a>
                                </td>
                                <td>
                                    <button class="btn btn-danger deleteButton" onclick="confirmDeleteTeam(@team.teamId, '@team.teamName')">Verwijder</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function confirmDeleteTeam(teamId, teamName) {
            if (confirm(`Weet je zeker dat je het team ${teamName} wilt verwijderen?`)) {
                $.ajax({
                    url: `/Team/TeamDelete/${teamId}`,
                    type: 'POST',
                    success: function (result) {
                        console.log(result);
                        window.location.href = '/Team/TeamList';
                    },
                    error: function (error) {
                        console.error('Er is een fout opgetreden bij het verwijderen van het team:', error);
                    }
                });
            }
        }
    </script>
</body>
</html>