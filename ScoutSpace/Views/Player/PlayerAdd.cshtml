@using Core.Domain.Extensions
@using Core.Domain
@model Player

@{
    ViewData["Title"] = "PlayerAdd Page";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="description" content="PlayerAdd Page">
</head>
<body>
    <div class="container-body">
        <a asp-area="" asp-controller="Player" asp-action="PlayerList" class="btn btn-primary addButton mt-3" style="margin-right: 5px;">Bekijk spelerlijst</a>
        <a asp-area="" asp-controller="Player" asp-action="PlayerTransfer" class="btn btn-primary addButton mt-3" style="margin-left: 5px;">Transfer speler</a>
        <h2>Voeg een nieuwe speler toe</h2>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <form id="addForm" action="/Player/PlayerAdd" method="post">

            <div class="row">
                <div class="col">
                    <div class="card container mb-3">
                        <div class="card-body">
                            <h4>Verplichte velden</h4>
                            <div class="row">
                                <div class="col">
                                    <div class="mb-3">
                                        <label for="firstName" class="form-label">Voornaam</label>
                                        <input type="text" class="form-control" id="firstName" name="firstName" value="@Html.DisplayFor(model => model.firstName)" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="mb-3">
                                        <label for="lastName" class="form-label">Achternaam</label>
                                        <input type="text" class="form-control" id="lastName" name="lastName" value="@Html.DisplayFor(model => model.lastName)" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="mb-3">
                                        <label for="birthDate" class="form-label">Geboortedatum</label>
                                        <input type="date" class="form-control" id="birthDate" name="birthDate" value="@Html.DisplayFor(model => model.birthDate)" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col">
                    <div class="card container optional mb-3">
                        <div class="card-body">
                            <h4 onclick="toggleOptionalFields()">Optionele velden</h4>

                            <div class="details" style="display: none;">
                                <div class="row">
                                    <div class="col">
                                        <div class="mb-3">
                                            <label for="email" class="form-label">Email</label>
                                            <input type="email" class="form-control" id="email" name="email" value="@Html.DisplayFor(model => model.email)">
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <label for="residence" class="form-label">Woonplaats</label>
                                            <input type="text" class="form-control" id="residence" name="residence" value="@Html.DisplayFor(model => model.residence)">
                                        </div>
                                    </div>
                                </div>


                                <div class="row">
                                    <div class="col">
                                        <div class="mb-3">
                                            <label for="phoneNr" class="form-label">Telefoon nr.</label>
                                            <input type="number" class="form-control" id="phoneNr" name="phoneNr" value="@Html.DisplayFor(model => model.phoneNr)">
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <label for="teamId" class="form-label">Team</label>
                                            <select asp-for="teamId" class="form-control">
                                                <option value="">-- Selecteer Team --</option>
                                                @if (ViewBag.Teams != null)
                                                {
                                                    foreach (var team in ViewBag.Teams)
                                                    {
                                                        <option value="@team.teamId">@team.teamName</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="" disabled>No teams available</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col">
                                            <div class="mb-3">
                                                <label for="position" class="form-label">Positie</label>
                                                <select asp-for="position" class="form-control" asp-items="Html.GetEnumSelectList<Position>()">
                                                    <option value="">-- Selecteer Positie --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="mb-3">
                                                <label for="line" class="form-label">Linie</label>
                                                <select asp-for="line" class="form-control" asp-items="Html.GetEnumSelectList<Line>()">
                                                    <option value="">-- Selecteer Linie --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="mb-3">
                                                <label for="preferedFoot" class="form-label">Been</label>
                                                <select asp-for="preferedFoot" class="form-control" asp-items="Html.GetEnumSelectList<Foot>()">
                                                    <option value="">-- Selecteer Been --</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <button type="submit" class="btn btn-primary addButton">Voeg toe</button>
        </form>
    </div>
</body>
</html>

<script>
    function toggleOptionalFields() {
        var details = document.querySelector('.details');
        if (details.style.display === "none") {
            details.style.display = "block";
        } else {
            details.style.display = "none";
        }
    }
</script>