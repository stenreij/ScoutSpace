@model Core.Domain.TransferPlayer

@{
    ViewData["Title"] = "PlayerTransfer Page";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="description" content="PlayerTransfer Page">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/5.0.0/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <a asp-area="" asp-controller="Player" asp-action="PlayerList" class="btn btn-primary addButton mt-3">Bekijk spelerlijst</a>
    <a asp-area="" asp-controller="Player" asp-action="PlayerAdd" class="btn btn-primary addButton mt-3">Voeg speler toe</a>
    <h2 class="mt-3">Transfer</h2>

    <form action="/Player/Transfer" method="post" id="transferForm">
        <div class="form-group">
            <label for="selectedPlayerId">Selecteer speler:</label>
            <select class="form-control" id="selectedPlayerId" name="selectedPlayerId">
                <option value="" disabled selected>Selecteer</option>
                @if (ViewBag.Players != null)
                {
                    foreach (var player in ViewBag.Players)
                    {
                        <option value="@player.playerId" data-team="@player.team?.teamName" data-division="@player.team?.division">@player.firstName @player.lastName</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mt-3">
            <label for="currentTeam"><strong><u>Huidig team:</u></strong></label>
            <br />
            <p id="currentTeam" style="display: inline;"></p>
            <br />
            <p id="currentTeamDivision" style="display: inline;"></p>
        </div>

        <div class="form-group mt-3">
            <label for="selectedNewTeam">Selecteer nieuw team:</label>
            <select asp-for="newTeamId" class="form-control" id="selectedNewTeam" name="newTeamId">
                <option value="" disabled selected>Selecteer</option>
                @if (ViewBag.Teams != null)
                {
                    foreach (var team in ViewBag.Teams)
                    {
                        <option value="@team.teamId">@team.teamName</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary addButton mt-3" id="confirmTransferBtn" disabled>Bevestig Transfer</button>
    </form>

    <script>
        $(document).ready(function () {
            $('#selectedPlayerId').change(function () {
                var selectedPlayerId = $(this).val();
                var selectedTeam = $(this).find(':selected').data('team');
                var selectedDivision = $(this).find(':selected').data('division');

                var formattedDivision = selectedDivision.replace(/([a-z])([A-Z])/g, '$1 $2');

                $('#currentTeam').text(selectedTeam);
                $('#currentTeamDivision').text(formattedDivision);

                $('#confirmTransferBtn').prop('disabled', false);
            });

            $('#transferForm').submit(function (e) {
                if ($('#confirmTransferBtn').is(':disabled')) {
                    e.preventDefault();
                    alert('Selecteer eerst een speler en nieuw team.');
                }
            });
        });
    </script>
</body>
</html>
