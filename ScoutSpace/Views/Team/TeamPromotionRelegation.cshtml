@using Core.Domain.Extensions

@model IEnumerable<Core.Domain.Team>

@{
    ViewData["Title"] = "Team Promotion & Relegation";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="description" content="Team Division Update">

    @section scripts {
        <script defer src="https://code.jquery.com/jquery-3.6.0.js"></script>
        <script defer src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.js"></script>
        <script defer src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.css">

        <script>
            $(document).ready(function () {
                $('form').submit(function () {
                    $('tbody tr').each(function () {
                        var teamId = $(this).find('input[name="teamId"]').val();
                        var promotionsCheckbox = $(this).find('input[name="promotions"]');
                        var relegationsCheckbox = $(this).find('input[name="relegations"]');

                        var promotionValue = promotionsCheckbox.prop('checked');
                        var relegationValue = relegationsCheckbox.prop('checked');

                        $(this).append('<input type="hidden" name="updateModels[' + teamId + '].teamId" value="' + teamId + '" />');
                        $(this).append('<input type="hidden" name="updateModels[' + teamId + '].Promotion" value="' + promotionValue + '" />');
                        $(this).append('<input type="hidden" name="updateModels[' + teamId + '].Relegation" value="' + relegationValue + '" />');
                    });
                });

                $('#teamTable').DataTable({
                    "language": {
                        "url": "/datatables/Dutch.json"
                    },
                    "responsive": true,
                });
            });
        </script>
    }
</head>
<body>
    <form action="/Team/TeamPromotionRelegation" method="post">
        <div class="container mt-3">
            <div class="table-responsive custom-table-container">
                <table id="teamTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Promotie</th>
                            <th scope="col">Degradatie</th>
                            <th scope="col">Id</th>
                            <th scope="col">Clubnaam</th>
                            <th scope="col">Divisie/Klasse</th>
                            <th scope="col">Plaats</th>
                            <th scope="col">Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in Model)
                        {
                            <tr>
                                <input type="hidden" name="teamId" value="@team.teamId" />
                                <td><input type="checkbox" name="promotions" /></td>
                                <td><input type="checkbox" name="relegations" /></td>
                                <td>@team.teamId</td>
                                <td>@team.teamName</td>
                                <td>@team.division.GetDisplayName()</td>
                                <td>@team.city</td>
                                <td>@team.contactNr</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update Divisions</button>
    </form>
</body>
</html>
